<mujoco model="toy_cleaner_sandbox">
  <compiler angle="degree" coordinate="local"/>

  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <geom contype="1" conaffinity="1" condim="3" friction="0.8 0.04 0.01"/>
    <joint damping="0.02"/>
    <default class="wheel">
      <geom type="cylinder" size="0.035 0.018" material="wheel_mat"
            mass="0.05" condim="4" friction="2.2 0.12 0.02"
            solref="0.01 1" solimp="0.9 0.95 0.001"/>
      <joint type="hinge" axis="1 0 0" damping="0.01" armature="0.0005"/>
    </default>
    <default class="chassis">
      <geom friction="0.5 0.02 0.01"/>
    </default>
    <default class="bumper">
      <geom friction="0.7 0.03 0.01"/>
    </default>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.18 0.24 0.28" rgb2="0.28 0.36 0.42"/>
    <material name="floor_mat" texture="grid" texrepeat="6 6" reflectance="0.15"/>
    <material name="rover_mat" rgba="0.9 0.9 0.86 1"/>
    <material name="wheel_mat" rgba="0.05 0.05 0.05 1"/>
    <material name="bumper_mat" rgba="1.0 0.45 0.12 1"/>
    <material name="obstacle_mat" rgba="0.45 0.45 0.48 1"/>
    <material name="toy_mat" rgba="0.95 0.82 0.18 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <camera name="overview" pos="0 -3.2 2.4" xyaxes="1 0 0 0 0.6 0.8"/>

    <geom name="floor" type="plane" size="3 3 0.05" material="floor_mat"/>

    <!-- Room edges. -->
    <geom name="back_wall" type="box" pos="0 1.5 0.2" size="1.5 0.04 0.2" material="obstacle_mat"/>
    <geom name="left_wall" type="box" pos="-1.5 0 0.2" size="0.04 1.5 0.2" material="obstacle_mat"/>
    <geom name="right_wall" type="box" pos="1.5 0 0.2" size="0.04 1.5 0.2" material="obstacle_mat"/>
    <geom name="front_wall" type="box" pos="0 -1.5 0.2" size="1.5 0.04 0.2" material="obstacle_mat"/>

    <body name="rover" pos="0 -0.45 0.0">
      <freejoint name="rover_free"/>
      <inertial pos="0 0 0.075" mass="0.75" diaginertia="0.0030 0.0025 0.0025"/>
      <!-- Approximate real rover envelope: 120 W x 200 L x 120 H mm. -->
      <geom name="chassis" class="chassis" type="box" pos="0 0 0.09" size="0.06 0.10 0.06"
            material="rover_mat"/>
      <geom name="front_bumper" class="bumper" type="box" pos="0 0.115 0.08" size="0.062 0.015 0.04"
            material="bumper_mat"/>
      <geom name="rear_bumper" class="bumper" type="box" pos="0 -0.115 0.08" size="0.062 0.012 0.035"
            material="bumper_mat"/>

      <body name="left_wheel" pos="-0.075 -0.07 0.035">
        <joint name="left_wheel_hinge" class="wheel"/>
        <geom name="left_wheel_geom" class="wheel" euler="0 90 0"/>
      </body>
      <body name="right_wheel" pos="0.075 -0.07 0.035">
        <joint name="right_wheel_hinge" class="wheel"/>
        <geom name="right_wheel_geom" class="wheel" euler="0 90 0"/>
      </body>
      <geom name="front_caster_geom" type="sphere" pos="0 0.075 0.025"
            size="0.02" mass="0.03" material="wheel_mat" condim="3"
            friction="0.4 0.02 0.01"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left_motor" joint="left_wheel_hinge" kv="0.08" ctrlrange="-20 20"/>
    <velocity name="right_motor" joint="right_wheel_hinge" kv="0.08" ctrlrange="-20 20"/>
  </actuator>
</mujoco>
